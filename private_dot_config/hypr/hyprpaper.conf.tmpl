# hyprpaper 0.8 config, generated by chezmoi from .chezmoidata/hosts.toml.
# One static wallpaper (Bierstadt's Buffalo Trail), cropped per monitor:
#   ~/Pictures/wallpapers/rotation/ultrawide/bierstadt-ultrawide.jpg   3440x1440 crop
#   ~/Pictures/wallpapers/rotation/1080p/bierstadt-1080p.jpg           1920x1080 crop
{{- range (dig "hosts" .chezmoi.hostname "monitors" list .) }}
{{- if get . "wallpaper" }}

wallpaper {
    monitor  = {{ .output }}
    path     = {{ .wallpaper }}
    fit_mode = cover
}
{{- end }}
{{- end }}

wallpaper {
    monitor  =
    path     = {{ dig "hosts" .chezmoi.hostname "wallpaper" "~/Pictures/wallpapers/rotation/1080p/bierstadt-1080p.jpg" . }}
    fit_mode = cover
}

splash = false
