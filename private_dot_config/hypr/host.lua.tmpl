-- Machine-specific Hyprland settings, generated by chezmoi for {{ .chezmoi.hostname }}.
-- Edit .chezmoidata/hosts.toml in the dotfiles repo (chezmoi cd), not this file.
{{- $h := dig "hosts" .chezmoi.hostname dict . }}
return {
    -- NVIDIA proprietary driver loaded when chezmoi last applied
    nvidia            = {{ if stat "/proc/driver/nvidia/version" }}true{{ else }}false{{ end }},
    drm_devices       = {{ if and (get $h "drm_devices") (stat ((get $h "drm_devices") | default "/nonexistent")) }}{{ (get $h "drm_devices") | quote }}{{ else }}nil{{ end }},
    primary_monitor   = {{ if (get $h "primary_monitor") }}{{ (get $h "primary_monitor") | quote }}{{ else }}nil{{ end }},
    secondary_monitor = {{ if (get $h "secondary_monitor") }}{{ (get $h "secondary_monitor") | quote }}{{ else }}nil{{ end }},
    wayvnc_output     = {{ if (get $h "wayvnc_output") }}{{ (get $h "wayvnc_output") | quote }}{{ else }}nil{{ end }},
}
