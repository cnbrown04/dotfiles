#!/usr/bin/env bash
set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
BIN="${HOME}/.local/bin"

log() { printf '==> %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

detect_platform() {
  case "$(uname -s)" in
    Darwin) PLATFORM=macos ;;
    Linux) PLATFORM=linux ;;
    *) die "unsupported OS: $(uname -s)" ;;
  esac

  DISTRO=
  if [[ "$PLATFORM" == linux && -f /etc/os-release ]]; then
    # shellcheck source=/dev/null
    . /etc/os-release
    DISTRO="${ID:-unknown}"
  fi
}

brew_shellenv() {
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  elif [[ -x "${HOME}/.linuxbrew/bin/brew" ]]; then
    # shellcheck source=/dev/null
    eval "$("${HOME}/.linuxbrew/bin/brew" shellenv)"
  elif have brew; then
    eval "$(brew shellenv)"
  fi
}

ensure_homebrew() {
  brew_shellenv
  have brew && return 0

  log "installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  brew_shellenv
  have brew || die "Homebrew install finished but brew is not on PATH"
}

install_brew_packages() {
  log "installing packages via Homebrew"
  ensure_homebrew
  brew update
  brew install \
    git zsh tmux neovim starship lazygit gh \
    lua-language-server rust-analyzer node curl
}

install_ghostty() {
  if have ghostty; then
    log "ghostty already installed"
    return 0
  fi

  log "installing ghostty"
  ensure_homebrew

  if [[ "$PLATFORM" == macos ]]; then
    brew install --cask ghostty
    return 0
  fi

  if brew install ghostty 2>/dev/null; then
    return 0
  fi

  case "$DISTRO" in
    ubuntu|debian|pop|linuxmint)
      if sudo apt-get update && sudo apt-get install -y ghostty 2>/dev/null; then
        return 0
      fi
      log "ghostty not in apt; installing via snap"
      sudo snap install ghostty --classic
      ;;
    fedora|rhel|centos)
      sudo dnf install -y ghostty
      ;;
    arch|manjaro)
      sudo pacman -S --needed --noconfirm ghostty
      ;;
    *)
      warn "ghostty not available via brew or ${DISTRO}; see https://ghostty.org/download"
      ;;
  esac
}

install_ghostty_font() {
  log "installing JetBrainsMono Nerd Font"
  ensure_homebrew

  if [[ "$PLATFORM" == macos ]]; then
    brew install --cask font-jetbrains-mono-nerd-font
    return 0
  fi

  if brew install font-jetbrains-mono-nerd-font 2>/dev/null; then
    return 0
  fi

  case "$DISTRO" in
    arch|manjaro)
      sudo pacman -S --needed --noconfirm ttf-jetbrains-mono-nerd
      ;;
    *)
      warn "install JetBrainsMono Nerd Font manually if ghostty falls back to a default font"
      ;;
  esac
}

install_npm_lsps() {
  if ! have npm; then
    warn "npm not found; skipping JS/Python LSP packages"
    return 0
  fi
  log "installing npm language servers"
  npm install -g pyright typescript typescript-language-server \
    vscode-langservers-extracted
}

setup_ghostty_platform() {
  local dir="${CONFIG}/ghostty"
  local link="${dir}/${PLATFORM}.conf"
  local target="platform/${PLATFORM}.conf"

  if [[ ! -f "${dir}/${target}" ]]; then
    warn "no ghostty platform config for ${PLATFORM}"
    return 0
  fi

  log "linking ghostty ${PLATFORM} config"
  ln -sf "$target" "$link"
  case "$PLATFORM" in
    macos) rm -f "${dir}/linux.conf" ;;
    linux) rm -f "${dir}/macos.conf" ;;
  esac
}

setup_zshenv() {
  if [[ -f /etc/zshenv ]] && grep -q 'ZDOTDIR=\$HOME/.config/zsh' /etc/zshenv; then
    log "/etc/zshenv already configured"
    return 0
  fi

  log "configuring /etc/zshenv (requires sudo)"
  sudo tee /etc/zshenv >/dev/null <<'EOF'
export ZDOTDIR=$HOME/.config/zsh
export XDG_CONFIG_HOME=$HOME/.config
export GIT_CONFIG_GLOBAL=$HOME/.config/git/config
EOF
}

setup_claude() {
  local src="${CONFIG}/.claude/settings.local.json"
  local dest="${HOME}/.claude/settings.local.json"

  if [[ ! -f "$src" ]]; then
    return 0
  fi

  log "linking Claude Code settings"
  mkdir -p "${HOME}/.claude"
  ln -sf "$src" "$dest"
}

install_zap() {
  if [[ -f "${DATA}/zap/zap.zsh" ]]; then
    log "zap already installed"
    return 0
  fi

  log "installing zap"
  zsh <(curl -fsSL https://raw.githubusercontent.com/zap-zsh/zap/master/install.zsh) --branch release-v1
}

install_tpm() {
  local tpm="${CONFIG}/tmux/.tmux/plugins/tpm"
  if [[ -d "$tpm" ]]; then
    log "TPM already installed"
    return 0
  fi

  log "installing tmux plugin manager (TPM)"
  git clone https://github.com/tmux-plugins/tpm "$tpm"
}

sync_nvim_plugins() {
  if ! have nvim; then
    warn "nvim not found; skipping plugin sync"
    return 0
  fi

  log "syncing neovim plugins"
  nvim --headless "+lua vim.cmd('packadd vim.pack'); vim.pack.sync()" +qa
}

suggest_default_shell() {
  local zsh_path
  zsh_path="$(brew --prefix 2>/dev/null)/bin/zsh"
  if [[ -x "$zsh_path" ]] && [[ "${SHELL:-}" != "$zsh_path" ]]; then
    warn "default shell is not Homebrew zsh; run: chsh -s $zsh_path"
  fi
}

main() {
  detect_platform
  install_brew_packages
  install_npm_lsps
  install_ghostty
  install_ghostty_font
  setup_ghostty_platform
  setup_zshenv
  setup_claude
  install_zap
  install_tpm
  sync_nvim_plugins
  suggest_default_shell
  log "done — open a new login shell (or run: exec zsh -l)"
}

main "$@"
