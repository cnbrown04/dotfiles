#!/usr/bin/env bash
# nightshift: macOS-style Night Shift on top of hyprsunset (warmer colors at night).
# Settings + the manual override live in $XDG_STATE_HOME/nightshift/state.json. hyprsunset runs once and is
# only driven over IPC (no profiles, so it never restarts and the screen never flashes back to white).
# `nightshift watch` (started by `start`) follows the schedule and eases the scheduled changes in over a
# minute like macOS; manual on/off lasts until the next scheduled change, like "Turn On Until Tomorrow".
# Every change also fades because of Hyprland's __internal_fadeCTM animation (hyprland.lua).
# Used by the Quickshell Control Center (NightShift.qml), Vicinae script commands and the Hyprland
# autostart. See ~/config.md.
#
#   nightshift                     status as JSON
#   nightshift start               (re)start hyprsunset + the schedule watcher, apply the current state
#   nightshift on|off|toggle       turn on/off now (until the next scheduled change)
#   nightshift temp KELVIN         color temperature, 1000-6500 (lower is warmer)
#   nightshift warmer|cooler       +/- 500K warmth
#   nightshift schedule on|off     use the From/To schedule
#   nightshift schedule FROM TO    set the schedule times (21:00, 9pm, 9:30pm...) and turn it on
#   nightshift from TIME | to TIME
#   nightshift summary             one line for humans ("On until 7:00 AM")
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/nightshift"
state="$state_dir/state.json"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprsunset.conf"
run_dir="${XDG_RUNTIME_DIR:-/tmp}/nightshift"
applied="$run_dir/applied"   # what's on screen: "on KELVIN" or "off"
ramp_secs=60                 # scheduled changes ease in over this long
ramp_step=2                  # seconds between steps (Hyprland fades each one)
neutral=6600                 # hyprsunset's matrix is ~identity here (1, 1, 0.99)
mkdir -p "$state_dir" "$run_dir"

# The watcher loops forever and takes the lock per tick, so it skips the global lock
if [ "${1:-}" = watch ]; then
    while sleep 15; do "$0" tick || true; done
    exit 0
fi
[ -s "$state" ] || printf '%s\n' '{"temperature":4000,"schedule":true,"from":"21:00","to":"07:00","override":null,"until":null}' > "$state"

# One writer at a time (the Control Center slider can fire quickly)
exec 9>"$state_dir/lock"
flock 9

get() { jq -r ".$1 // empty" "$state"; }
# set KEY JSON-VALUE [KEY JSON-VALUE...]; written in place so Quickshell's file watch keeps working
set_state() {
    local filter="." args=() i=0
    while [ $# -gt 0 ]; do
        filter="$filter | .$1 = \$v$i"; args+=(--argjson "v$i" "$2"); shift 2; i=$((i + 1))
    done
    local new; new=$(jq "${args[@]}" "$filter" "$state")
    printf '%s\n' "$new" > "$state"
}

die() { echo "nightshift: $*" >&2; exit 1; }
norm_time() { date -d "$1" +%H:%M 2>/dev/null || die "can't read the time '$1'"; }
minutes() { local h=${1%%:*} m=${1##*:}; echo $((10#$h * 60 + 10#$m)); }

# Is the schedule window (From..To, may wrap past midnight) active right now?
in_window() {
    [ "$(get schedule)" = true ] || return 1
    local f t n
    f=$(minutes "$(get from)"); t=$(minutes "$(get to)"); n=$(minutes "$(date +%H:%M)")
    [ "$f" -eq "$t" ] && return 1
    if [ "$f" -lt "$t" ]; then [ "$n" -ge "$f" ] && [ "$n" -lt "$t" ]
    else [ "$n" -ge "$f" ] || [ "$n" -lt "$t" ]; fi
}

# Epoch of the next scheduled change (empty when the schedule is off)
next_change() {
    [ "$(get schedule)" = true ] || return 0
    local now best="" t e
    now=$(date +%s)
    for t in "$(get from)" "$(get to)"; do
        e=$(date -d "today $t" +%s)
        [ "$e" -le "$now" ] && e=$(date -d "tomorrow $t" +%s)
        if [ -z "$best" ] || [ "$e" -lt "$best" ]; then best=$e; fi
    done
    echo "$best"
}

override_live() {
    local o u
    o=$(get override); u=$(get until)
    [ -n "$o" ] || return 1
    [ -z "$u" ] || [ "$(date +%s)" -lt "$u" ]
}

is_active() {
    if override_live; then [ "$(get override)" = on ]; else in_window; fi
}

running() { pgrep -xu "$(id -u)" hyprsunset >/dev/null; }
watching() { pgrep -u "$(id -u)" -f "$0 watch\$" >/dev/null; }

write_conf() {
    mkdir -p "$(dirname "$conf")"
    {
        echo "# Generated by ~/.local/bin/nightshift (don't edit). No profiles on purpose: the schedule is run by"
        echo "# \`nightshift watch\` over IPC so changes can fade in. Settings: $state"
    } > "$conf"
}

target() { if is_active; then echo "on $(get temperature)"; else echo off; fi; }
kelvin_of() { case "$1" in on\ *) echo "${1#on }" ;; *) echo "$neutral" ;; esac; }

# Push the current on/off + temperature to hyprsunset (Hyprland fades it)
apply() {
    running || return 0
    local t; t=$(target)
    printf '%s\n' "$t" > "$applied"
    if [ "$t" = off ]; then
        hyprctl hyprsunset identity >/dev/null
    else
        hyprctl hyprsunset temperature "$(kelvin_of "$t")" >/dev/null
    fi
}

# Watcher tick: if the schedule (or an expired override) changed what should be on screen, ease into it
tick() {
    running || return 0
    local want have
    want=$(target); have=$(cat "$applied" 2>/dev/null || echo off)
    [ "$want" = "$have" ] && return 0
    printf '%s\n' "$want" > "$applied"
    flock -u 9   # don't block the Control Center while ramping
    local from to steps i k
    from=$(kelvin_of "$have"); to=$(kelvin_of "$want"); steps=$((ramp_secs / ramp_step))
    for ((i = 1; i <= steps; i++)); do
        # Someone changed it by hand mid-ramp: theirs wins
        [ "$(cat "$applied" 2>/dev/null)" = "$want" ] || return 0
        # smoothstep, so it starts and ends gently
        k=$(awk -v a="$from" -v b="$to" -v t="$i" -v n="$steps" \
            'BEGIN { x = t / n; x = x * x * (3 - 2 * x); printf "%d", a + (b - a) * x }')
        hyprctl hyprsunset temperature "$k" >/dev/null
        sleep "$ramp_step"
    done
    [ "$want" = off ] && [ "$(cat "$applied" 2>/dev/null)" = off ] && hyprctl hyprsunset identity >/dev/null
    return 0
}

restart() {
    write_conf
    pkill -u "$(id -u)" -f "$0 watch\$" 2>/dev/null || true
    pkill -xu "$(id -u)" hyprsunset 2>/dev/null || true
    for _ in $(seq 20); do running || break; sleep 0.05; done
    # Start in the right state so there's no flash of the wrong one; profiles still drive the schedule
    local flags=(-i)
    is_active && flags=(-t "$(get temperature)")
    setsid -f hyprsunset "${flags[@]}" >/dev/null 2>&1 </dev/null 9>&-
    for _ in $(seq 40); do
        hyprctl hyprsunset profile >/dev/null 2>&1 && hyprctl hyprsunset gamma 2>/dev/null | grep -q '^[0-9]' && break
        sleep 0.05
    done
    apply
    setsid -f "$0" watch >/dev/null 2>&1 </dev/null 9>&-
}

# Apply a settings change live; only (re)start when nothing is running yet
refresh() { if running && watching; then apply; else restart; fi; }

# Turn on/off now: an override until the next scheduled change, or none if that's what the schedule says
set_on() {
    local want=$1
    local sched=false; in_window && sched=true
    if [ "$want" = "$sched" ]; then
        set_state override null until null
    else
        local u; u=$(next_change)
        set_state override "\"$([ "$want" = true ] && echo on || echo off)\"" until "${u:-null}"
    fi
    refresh
}

clock12() { date -d "$1" '+%-I:%M %p'; }

status_json() {
    local active=false u="" o=null
    is_active && active=true
    if override_live; then o="\"$(get override)\""; u=$(get until); else u=$(next_change); fi
    local running_=false; running && running_=true
    jq -c --argjson active "$active" --argjson running "$running_" --argjson override "$o" \
        --arg until "${u:+$(date -d "@$u" +%H:%M)}" \
        '{active: $active, running: $running, temperature, schedule, from, to, override: $override,
          until: (if $until == "" then null else $until end)}' "$state"
}

summary() {
    local u; u=$(status_json | jq -r '.until // empty')
    local word=Off; is_active && word=On
    if [ -n "$u" ]; then echo "Night Shift: $word until $(clock12 "$u") ($(get temperature)K)"
    else echo "Night Shift: $word ($(get temperature)K)"; fi
}

clamp_temp() {
    local k=$1
    [[ "$k" =~ ^[0-9]+$ ]] || die "temperature must be a number of Kelvin, e.g. 4000"
    [ "$k" -lt 1000 ] && k=1000
    [ "$k" -gt 6500 ] && k=6500
    echo "$k"
}

set_temp() {
    set_state temperature "$(clamp_temp "$1")"
    refresh
}

cmd=${1:-status}
case "$cmd" in
    status|"")  status_json ;;
    summary)    summary ;;
    start|restart) restart ;;
    apply)      apply ;;
    tick)       tick ;;
    on)         set_on true; summary ;;
    off)        set_on false; summary ;;
    toggle)     if is_active; then set_on false; else set_on true; fi; summary ;;
    temp|temperature)
        [ $# -ge 2 ] || { get temperature; exit 0; }
        set_temp "${2%[kK]}"; summary ;;
    warmer)     set_temp $(( $(get temperature) - 500 )); summary ;;
    cooler)     set_temp $(( $(get temperature) + 500 )); summary ;;
    schedule)
        case "${2:-}" in
            on|true)   set_state schedule true override null until null ;;
            off|false) set_state schedule false override null until null ;;
            "")        get schedule; exit 0 ;;
            *)         [ $# -ge 3 ] || die "usage: nightshift schedule FROM TO"
                       set_state schedule true from "\"$(norm_time "$2")\"" to "\"$(norm_time "$3")\"" override null until null ;;
        esac
        refresh; summary ;;
    from|to)
        [ $# -ge 2 ] || { get "$cmd"; exit 0; }
        set_state "$cmd" "\"$(norm_time "$2")\"" override null until null
        refresh; summary ;;
    -h|--help|help) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (try: nightshift help)" ;;
esac
