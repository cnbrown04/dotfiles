#!/usr/bin/env python3
"""Rotate wallpapers on all monitors in sync, via hyprpaper IPC.

Each wallpaper has one pre-cropped image per screen shape:
    ~/Pictures/wallpapers/rotation/ultrawide/<name>-ultrawide.jpg   (monitors wider than 2:1)
    ~/Pictures/wallpapers/rotation/1080p/<name>-1080p.jpg           (everything else)
Wallpapers are paired by <name>; one present in only one folder is used for that shape alone.

Usage:
    wallpaper-rotate daemon   apply the current wallpaper, then advance every INTERVAL seconds (started by Hyprland)
    wallpaper-rotate next     switch to the next wallpaper now (also restarts the daemon's timer)
    wallpaper-rotate          show the rotation list and current index
"""
import json
import os
import signal
import subprocess
import sys
import threading

INTERVAL = 30 * 60
ROOT = os.path.expanduser("~/Pictures/wallpapers/rotation")
STATE = os.path.expanduser("~/.cache/wallpaper-rotate")
SHAPES = {"ultrawide": "-ultrawide", "1080p": "-1080p"}


def catalog():
    """{name: {shape: path}} for every image in the rotation folders."""
    walls = {}
    for shape, suffix in SHAPES.items():
        d = os.path.join(ROOT, shape)
        for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            stem, ext = os.path.splitext(f)
            if ext.lower() not in (".jpg", ".jpeg", ".png", ".webp", ".jxl"):
                continue
            name = stem[: -len(suffix)] if stem.endswith(suffix) else stem
            walls.setdefault(name, {})[shape] = os.path.join(d, f)
    return walls


def read_index():
    try:
        return int(open(STATE).read().strip())
    except (OSError, ValueError):
        return 0


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def apply(index):
    walls = catalog()
    if not walls:
        print(f"no wallpapers in {ROOT}", file=sys.stderr)
        return
    names = sorted(walls)
    name = names[index % len(names)]
    for mon in json.loads(hyprctl("monitors", "-j") or "[]"):
        w, h = mon["width"], mon["height"]
        if mon.get("transform", 0) % 2:
            w, h = h, w
        want = "ultrawide" if w / h > 2 else "1080p"
        path = walls[name].get(want) or next(iter(walls[name].values()))
        hyprctl("hyprpaper", "wallpaper", f"{mon['name']},{path},cover")
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        f.write(str(index % len(names)))
    print(f"wallpaper: {name}", flush=True)


def daemon():
    wake = threading.Event()
    signal.signal(signal.SIGUSR1, lambda *_: wake.set())
    apply(read_index())
    while True:
        skipped = wake.wait(INTERVAL)
        wake.clear()
        if not skipped:  # timer expired; `next` already advanced the index itself
            apply(read_index() + 1)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "daemon":
        daemon()
    elif cmd == "next":
        apply(read_index() + 1)
        subprocess.run(["pkill", "-USR1", "-f", r"^python3 .*/wallpaper-rotate daemon$"])
    elif cmd == "status":
        names, cur = sorted(catalog()), read_index()
        for i, n in enumerate(names):
            print(("* " if names and i == cur % len(names) else "  ") + n)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
