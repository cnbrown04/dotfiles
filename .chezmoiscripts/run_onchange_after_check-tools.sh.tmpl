#!/bin/sh
# Point out tools the configs expect but this machine doesn't have yet.
# chezmoi may run from a shell that has not picked up these yet (fresh machine)
PATH="$HOME/.local/bin:$HOME/.opencode/bin:$PATH"
missing=""
for cmd in zsh git nvim tmux starship zoxide mise fzf lazygit opencode{{ if or (lookPath "Hyprland") (lookPath "hyprland") }} hyprpaper hypridle hyprlock qs vicinae cliphist wl-copy grim slurp satty udiskie moniqued{{ end }}; do
    command -v "$cmd" >/dev/null 2>&1 || missing="$missing $cmd"
done
[ -n "$missing" ] && echo "chezmoi: not installed yet:$missing" >&2
exit 0
