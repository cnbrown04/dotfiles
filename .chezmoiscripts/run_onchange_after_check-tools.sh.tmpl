#!/bin/sh
# Point out tools the configs expect but this machine doesn't have yet.
missing=""
for cmd in zsh git nvim tmux starship zoxide mise fzf lazygit{{ if or (lookPath "Hyprland") (lookPath "hyprland") }} hyprpaper hypridle hyprlock qs vicinae cliphist wl-copy grim slurp satty udiskie moniqued{{ end }}; do
    command -v "$cmd" >/dev/null 2>&1 || missing="$missing $cmd"
done
[ -n "$missing" ] && echo "chezmoi: not installed yet:$missing" >&2
exit 0
