{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# macOS: install the same tool stack as on Linux. Reruns whenever this list changes.
set -e
if ! command -v brew >/dev/null 2>&1; then
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ -x "$b" ] && eval "$("$b" shellenv)"; done
fi
if ! command -v brew >/dev/null 2>&1; then
    echo "chezmoi: Homebrew isn't installed, skipping packages (https://brew.sh, then chezmoi apply)" >&2
    exit 0
fi
# third-party tap entries have to be trusted before Homebrew will load them
brew trust --quiet --formula anomalyco/tap/opencode-v2
brew trust --quiet --cask nikitabobko/tap/aerospace
brew bundle --file=/dev/stdin <<'BREWFILE'
brew "git"
brew "gh"
brew "neovim"
brew "tmux"
brew "starship"
brew "zoxide"
brew "mise"
brew "fzf"
brew "lazygit"
brew "superfile"
brew "lua-language-server"
brew "anomalyco/tap/opencode-v2"
cask "ghostty"
cask "1password"
cask "font-jetbrains-mono-nerd-font"
cask "nikitabobko/tap/aerospace"
cask "raycast"
cask "vorssaint"
BREWFILE
{{ end -}}
