{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Linux: the packages for the security keys. Reruns when this list changes.
# - gpg-agent + scdaemon + pcscd: the SSH agent, with the PIV keys that sign git commits
#   (~/.gnupg). pinentry asks for the PIV PIN.
# - libfido2: ssh-sk-helper uses it for the FIDO2 keys of the SSH logins (~/.ssh/config).
# - opensc: ssh-keygen -D reads the public key of a PIV slot.
# - pcsclite headers + libudev: mise builds keyroost (cargo:keyroost) with them.
if command -v apt-get >/dev/null 2>&1; then
    pkgs="gnupg scdaemon pcscd pinentry-gnome3 libfido2-1 opensc libpcsclite-dev libudev-dev pkg-config"
    missing=""
    for p in $pkgs; do dpkg -s "$p" >/dev/null 2>&1 || missing="$missing $p"; done
    # shellcheck disable=SC2086 # one word for each package
    [ -z "$missing" ] || sudo apt-get install -y $missing || { echo "chezmoi: security key packages failed:$missing" >&2; exit 0; }
elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm gnupg pcsclite pinentry libfido2 opensc systemd-libs pkgconf \
        || { echo "chezmoi: security key packages failed" >&2; exit 0; }
elif command -v dnf >/dev/null 2>&1; then
    # Not tested on Fedora.
    sudo dnf install -y gnupg2 gnupg2-scdaemon pcsc-lite pinentry-gnome3 libfido2 opensc pcsc-lite-devel systemd-devel pkgconf \
        || { echo "chezmoi: security key packages failed" >&2; exit 0; }
else
    echo "chezmoi: don't know how to install the security key packages here, skipping" >&2
    exit 0
fi
# scdaemon reads the cards through pcscd (~/.gnupg/scdaemon.conf has disable-ccid).
if command -v systemctl >/dev/null 2>&1 && ! systemctl is-enabled --quiet pcscd.socket 2>/dev/null; then
    sudo systemctl enable --now pcscd.socket >/dev/null 2>&1
fi
exit 0
{{ end -}}
