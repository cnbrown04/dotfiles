{{ if lookPath "gh" -}}
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
{{ end -}}
[user]
	name = {{ .name }}
	email = {{ .email }}
{{- /* Sign each commit and tag with the PIV key of the security key. The
       gpg-agent holds the key (sshcontrol) and asks for the PIN one time, so a
       signature needs no PIN. hephaestus never has the YubiKey 5C Nano, so it
       signs with the Token2. The other machines sign with the Nano. */}}
{{- if eq .chezmoi.hostname "hephaestus" }}
	signingkey = key::ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBIoU9vKwHiWXIM+g83dCUku9MBZ1RLMUi1lKthSidb/i4N8WOcrHHcsdij1aWyo+Hua5qgKInFbDOGF9Q1ryabE=
{{- else }}
	signingkey = key::ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBJ4Xk5FXh0x31JtmNc6yypVlKT/dO4l+tuQTDtbOa5qwKwrkqbpVEAk9W1FxT3IOPbvrohpdB+Ckf0UeEKG8x1Q=
{{- end }}
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
