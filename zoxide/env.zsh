# zoxide has no config file; options are environment variables (see: zoxide --help).
# Must be set before `zoxide init` in zsh/.zshrc.
#
# Database (default on macOS): ~/Library/Application Support/zoxide/db.zo
# Optional: store under XDG data instead (uncomment and migrate db.zo if needed)
# export _ZO_DATA_DIR="${XDG_DATA_HOME}/zoxide"

# export _ZO_MAXAGE=10000
# export _ZO_EXCLUDE_DIRS="${HOME}:${HOME}/.Trash/*"
# export _ZO_FZF_OPTS="--height 40%"
