# zsh runtime
zsh/.zsh_history
zsh/.zcompdump*
zsh/.zsh_sessions/

# tmux plugins (installed by bootstrap)
tmux/.tmux/plugins/

# cursor (not managed in dotfiles)
cursor/

# claude local overrides
.claude/
nvim/.claude/

# gh auth state (tokens live in keychain; hosts.yml is machine-local)
gh/hosts.yml

# raycast (not managed in dotfiles)
raycast/

# ghostty platform symlinks (created by bootstrap)
ghostty/macos.conf
ghostty/linux.conf

