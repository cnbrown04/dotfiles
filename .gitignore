# zsh runtime
zsh/.zsh_history
zsh/.zcompdump*
zsh/.zsh_sessions/

# tmux plugins (installed by bootstrap)
tmux/.tmux/plugins/

# cursor runtime (cli-config.json is tracked)
cursor/statsig-cache.json
cursor/chats/

# claude runtime at ~/.claude (settings.local.json is tracked under .claude/)
nvim/.claude/

# gh auth state (tokens live in keychain; hosts.yml is machine-local)
gh/hosts.yml

# raycast (installed extensions, not dotfiles)
raycast/

# ghostty platform symlinks (created by bootstrap)
ghostty/macos.conf
ghostty/linux.conf

# macOS
.DS_Store
